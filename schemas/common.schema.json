{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": false,
          "default": false,
          "title": "Ok",
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "JsonValue": {},
    "SuccessResponse": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "data"
      ],
      "title": "SuccessResponse",
      "type": "object"
    },
    "TimeRangeUs": {
      "additionalProperties": false,
      "properties": {
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "end_us": {
          "exclusiveMinimum": 0,
          "title": "End Us",
          "type": "integer"
        }
      },
      "required": [
        "start_us",
        "end_us"
      ],
      "title": "TimeRangeUs",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/FileRef"
    },
    {
      "$ref": "#/$defs/TimeRangeUs"
    },
    {
      "$ref": "#/$defs/SuccessResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ]
}
