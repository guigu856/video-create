{
  "$defs": {
    "AudioVisualRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Relation Id",
          "type": "string"
        },
        "relation_type": {
          "enum": [
            "sync",
            "anticipation",
            "post_beat_release",
            "sustain",
            "non_beat_binding"
          ],
          "title": "Relation Type",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRangeUs"
        },
        "claim": {
          "$ref": "#/$defs/EvidenceBackedClaim"
        }
      },
      "required": [
        "relation_id",
        "relation_type",
        "time_range",
        "claim"
      ],
      "title": "AudioVisualRelation",
      "type": "object"
    },
    "BgmAnalysis": {
      "additionalProperties": false,
      "properties": {
        "audio_scope": {
          "enum": [
            "mixed_program_audio",
            "isolated_bgm"
          ],
          "title": "Audio Scope",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/MusicSection"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "tempo_candidates": {
          "items": {
            "$ref": "#/$defs/TempoEvidence"
          },
          "title": "Tempo Candidates",
          "type": "array"
        },
        "audiovisual_relations": {
          "items": {
            "$ref": "#/$defs/AudioVisualRelation"
          },
          "title": "Audiovisual Relations",
          "type": "array"
        }
      },
      "required": [
        "audio_scope",
        "sections",
        "tempo_candidates",
        "audiovisual_relations"
      ],
      "title": "BgmAnalysis",
      "type": "object"
    },
    "CreationContextProjection": {
      "additionalProperties": false,
      "properties": {
        "stage1_knowledge": {
          "items": {
            "$ref": "#/$defs/ProjectedKnowledge"
          },
          "title": "Stage1 Knowledge",
          "type": "array"
        },
        "stage2_knowledge": {
          "items": {
            "$ref": "#/$defs/ProjectedKnowledge"
          },
          "title": "Stage2 Knowledge",
          "type": "array"
        },
        "stage3_knowledge": {
          "items": {
            "$ref": "#/$defs/ProjectedKnowledge"
          },
          "title": "Stage3 Knowledge",
          "type": "array"
        }
      },
      "required": [
        "stage1_knowledge",
        "stage2_knowledge",
        "stage3_knowledge"
      ],
      "title": "CreationContextProjection",
      "type": "object"
    },
    "EditingGrammar": {
      "additionalProperties": false,
      "properties": {
        "viewing_experience": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedClaim"
          },
          "minItems": 1,
          "title": "Viewing Experience",
          "type": "array"
        },
        "reusable_sentences": {
          "items": {
            "$ref": "#/$defs/EditingSentence"
          },
          "minItems": 1,
          "title": "Reusable Sentences",
          "type": "array"
        },
        "reference_specific_notes": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedClaim"
          },
          "title": "Reference Specific Notes",
          "type": "array"
        }
      },
      "required": [
        "viewing_experience",
        "reusable_sentences",
        "reference_specific_notes"
      ],
      "title": "EditingGrammar",
      "type": "object"
    },
    "EditingSentence": {
      "additionalProperties": false,
      "properties": {
        "sentence_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Sentence Id",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "sentence_id",
        "content",
        "evidence_refs",
        "confidence"
      ],
      "title": "EditingSentence",
      "type": "object"
    },
    "EvidenceBackedClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Claim Id",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "fact_status": {
          "enum": [
            "measured",
            "algorithm_candidate",
            "agent_inference",
            "reconstruction_suggestion"
          ],
          "title": "Fact Status",
          "type": "string"
        },
        "importance": {
          "enum": [
            "important",
            "supporting"
          ],
          "title": "Importance",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "content",
        "fact_status",
        "importance",
        "confidence",
        "evidence_refs"
      ],
      "title": "EvidenceBackedClaim",
      "type": "object"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Analysis Id",
          "type": "string"
        },
        "source_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Media Sha256",
          "type": "string"
        },
        "analysis_version": {
          "minLength": 1,
          "title": "Analysis Version",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EvidenceEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "analysis_id",
        "source_media_sha256",
        "analysis_version",
        "entries"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "EvidenceEntry": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "frame",
            "contact_sheet",
            "frame_index",
            "visual_signals",
            "boundary_candidates",
            "audio_pcm",
            "waveform",
            "waveform_visualization",
            "audio_signals",
            "refinement"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/FileRef"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRangeUs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fact_status": {
          "enum": [
            "measured",
            "algorithm_candidate"
          ],
          "title": "Fact Status",
          "type": "string"
        },
        "algorithm_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm Version"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "file",
        "fact_status"
      ],
      "title": "EvidenceEntry",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "MusicSection": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Section Id",
          "type": "string"
        },
        "section_type": {
          "enum": [
            "intro",
            "build",
            "drive",
            "climax",
            "buffer",
            "outro"
          ],
          "title": "Section Type",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRangeUs"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedClaim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "section_type",
        "time_range",
        "claims"
      ],
      "title": "MusicSection",
      "type": "object"
    },
    "OverviewSection": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "enum": [
            "video_type_and_core_mechanism",
            "production_method",
            "visual_language",
            "rhythm_and_sound",
            "transition_principles",
            "asset_and_music_traits",
            "viewing_experience"
          ],
          "title": "Section",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedClaim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "section",
        "claims"
      ],
      "title": "OverviewSection",
      "type": "object"
    },
    "ProjectedKnowledge": {
      "additionalProperties": false,
      "properties": {
        "projection_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Projection Id",
          "type": "string"
        },
        "applicable_stage": {
          "enum": [
            "stage1",
            "stage2",
            "stage3"
          ],
          "title": "Applicable Stage",
          "type": "string"
        },
        "knowledge_type": {
          "minLength": 1,
          "title": "Knowledge Type",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact_status": {
          "default": "agent_inference",
          "enum": [
            "agent_inference",
            "reconstruction_suggestion"
          ],
          "title": "Fact Status",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "transferability": {
          "const": "reusable_mechanism",
          "default": "reusable_mechanism",
          "title": "Transferability",
          "type": "string"
        }
      },
      "required": [
        "projection_id",
        "applicable_stage",
        "knowledge_type",
        "content",
        "evidence_refs",
        "confidence"
      ],
      "title": "ProjectedKnowledge",
      "type": "object"
    },
    "ReferenceShot": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Shot Id",
          "type": "string"
        },
        "rhythm_unit_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Rhythm Unit Id",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRangeUs"
        },
        "main_picture": {
          "minLength": 1,
          "title": "Main Picture",
          "type": "string"
        },
        "visible_layers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Visible Layers",
          "type": "array"
        },
        "visual_change": {
          "minLength": 1,
          "title": "Visual Change",
          "type": "string"
        },
        "effect_scope": {
          "minLength": 1,
          "title": "Effect Scope",
          "type": "string"
        },
        "sound_relation": {
          "minLength": 1,
          "title": "Sound Relation",
          "type": "string"
        },
        "connection": {
          "minLength": 1,
          "title": "Connection",
          "type": "string"
        },
        "sentence_function": {
          "minLength": 1,
          "title": "Sentence Function",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedClaim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "shot_id",
        "rhythm_unit_id",
        "time_range",
        "main_picture",
        "visible_layers",
        "visual_change",
        "effect_scope",
        "sound_relation",
        "connection",
        "sentence_function",
        "claims"
      ],
      "title": "ReferenceShot",
      "type": "object"
    },
    "ReferenceShotAnalysis": {
      "additionalProperties": false,
      "properties": {
        "duration_us": {
          "exclusiveMinimum": 0,
          "title": "Duration Us",
          "type": "integer"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/ReferenceShot"
          },
          "minItems": 1,
          "title": "Shots",
          "type": "array"
        }
      },
      "required": [
        "duration_us",
        "shots"
      ],
      "title": "ReferenceShotAnalysis",
      "type": "object"
    },
    "TempoEvidence": {
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "exclusiveMinimum": 0,
          "title": "Bpm",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "bpm",
        "confidence",
        "evidence_refs"
      ],
      "title": "TempoEvidence",
      "type": "object"
    },
    "TimeRangeUs": {
      "additionalProperties": false,
      "properties": {
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "end_us": {
          "exclusiveMinimum": 0,
          "title": "End Us",
          "type": "integer"
        }
      },
      "required": [
        "start_us",
        "end_us"
      ],
      "title": "TimeRangeUs",
      "type": "object"
    },
    "VideoOverview": {
      "additionalProperties": false,
      "properties": {
        "sections": {
          "items": {
            "$ref": "#/$defs/OverviewSection"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "sections"
      ],
      "title": "VideoOverview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Report Id",
      "type": "string"
    },
    "analysis_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Analysis Id",
      "type": "string"
    },
    "source_media_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Media Sha256",
      "type": "string"
    },
    "analysis_version": {
      "minLength": 1,
      "title": "Analysis Version",
      "type": "string"
    },
    "duration_us": {
      "exclusiveMinimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "evidence_bundle": {
      "$ref": "#/$defs/EvidenceBundle"
    },
    "video_overview": {
      "$ref": "#/$defs/VideoOverview"
    },
    "bgm_analysis": {
      "$ref": "#/$defs/BgmAnalysis"
    },
    "shot_analysis": {
      "$ref": "#/$defs/ReferenceShotAnalysis"
    },
    "editing_grammar": {
      "$ref": "#/$defs/EditingGrammar"
    },
    "creation_context_projection": {
      "$ref": "#/$defs/CreationContextProjection"
    }
  },
  "required": [
    "report_id",
    "analysis_id",
    "source_media_sha256",
    "analysis_version",
    "duration_us",
    "evidence_bundle",
    "video_overview",
    "bgm_analysis",
    "shot_analysis",
    "editing_grammar",
    "creation_context_projection"
  ],
  "title": "ReferenceStudyReport",
  "type": "object"
}
